# Production defaults — overridden by docker-compose.prod.yml build args and runtime env vars.
# NEXT_PUBLIC_* vars here are baked into the bundle when docker-compose.prod.yml doesn't
# pass them explicitly as build args (e.g. CI without a .env file present).

NEXT_PUBLIC_APP_URL=https://linkcharts.com.br
NEXT_PUBLIC_REDIRECT_URL=https://redirect.linkcharts.com.br
NEXT_PUBLIC_SUBDOMAINS_ENABLED=true
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GA_ID=G-C06GRDGSW1
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18126255245
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-1396026257166470
NEXT_PUBLIC_ADSENSE_SLOT_SHORTER_BELOW_FORM=
NEXT_PUBLIC_ADSENSE_SLOT_SHORTER_BETWEEN_SECTIONS=
NEXT_PUBLIC_ADSENSE_SLOT_ANALYTICS_ABOVE_CHARTS=
NEXT_PUBLIC_ADSENSE_SLOT_ANALYTICS_BELOW_CHARTS=

# Auth0 — server-only runtime vars (secrets injected via CI/CD or server .env, not committed here)
APP_BASE_URL=https://linkcharts.com.br
AUTH0_DOMAIN=login.linkcharts.com.br
# AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET and AUTH0_SECRET are injected via CI/CD secrets at deploy (not committed)
AUTH0_CLIENT_ID=

# Server-only runtime env vars
# GOOGLE_SAFE_BROWSING_KEY real value is injected via CI/CD secrets at deploy (not committed)
GOOGLE_SAFE_BROWSING_KEY=
