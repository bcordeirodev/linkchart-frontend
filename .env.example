# =============================================================================
# Link Charts — frontend-next environment template
# Copy to .env.local for local development and fill in the values you need.
# NEXT_PUBLIC_* vars are PUBLIC: inlined into the client bundle at build time.
# All other vars are SERVER-ONLY: read at runtime, never shipped to the browser.
# Secrets (marked below) must come from a secrets manager / CI-CD in production.
# =============================================================================

# --- Public client vars (NEXT_PUBLIC_*, baked into the bundle) ---------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REDIRECT_URL=http://localhost:8000/r
NEXT_PUBLIC_SUBDOMAINS_ENABLED=false

# Analytics / Ads (public). Leave GA/AdSense empty to disable their scripts.
NEXT_PUBLIC_GA_ID=
# Google Ads conversion tag (gtag.js AW-XXXXXXXXXX). Empty = no Ads config.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Grafana Faro RUM + tracing. Leave NEXT_PUBLIC_FARO_URL empty to disable Faro.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_FARO_APP_NAME=linkcharts-frontend
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_SHORTER_BELOW_FORM=
NEXT_PUBLIC_ADSENSE_SLOT_SHORTER_BETWEEN_SECTIONS=
NEXT_PUBLIC_ADSENSE_SLOT_ANALYTICS_ABOVE_CHARTS=
NEXT_PUBLIC_ADSENSE_SLOT_ANALYTICS_BELOW_CHARTS=

# --- Server-only vars (runtime, not exposed to the client) -------------------
# Backend base URL used by the /api/* proxy rewrite in next.config.ts.
API_URL=http://localhost:8000

# Auth0 (server-side @auth0/nextjs-auth0). Public base URL of this app.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
# SECRET — Auth0 application client secret (inject via CI/CD secrets in prod).
AUTH0_CLIENT_SECRET=
# SECRET — 32+ byte random string used to encrypt the session cookie
# (generate with: openssl rand -hex 32). Inject via CI/CD secrets in prod.
AUTH0_SECRET=

# SECRET — Google Safe Browsing API key (server-only, no NEXT_PUBLIC_).
# Leave empty to fail open (URL safety checks are skipped). Inject via CI/CD.
GOOGLE_SAFE_BROWSING_KEY=
